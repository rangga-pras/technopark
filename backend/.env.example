APP_ENV=development
MYSQLHOST=127.0.0.1
MYSQLPORT=3307
MYSQLUSER=technopark
MYSQLPASSWORD=replace-with-the-root-env-MYSQL_PASSWORD
MYSQLDATABASE=technopark_db
# Production Aiven: unggah CA sebagai secret file Render lalu aktifkan kedua baris ini.
MYSQL_SSL_REQUIRED=false
MYSQL_SSL_CA=
# Vercel: isi certificate PEM lengkap pada MYSQL_SSL_CA_PEM dan biarkan MYSQL_SSL_CA kosong.
MYSQL_SSL_CA_PEM=
JWT_SECRET_KEY=replace-with-random-64-hex-characters
TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Isi setelah seluruh daftar libur nasional dimasukkan dan diaudit.
# JSON tahun:URL sumber resmi; kosong berarti booking tahun tersebut diblokir.
HOLIDAY_CALENDARS={}
